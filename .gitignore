# Build artifacts and archives — the site is the source, don't commit copies of it
*.zip
*.tar
*.tar.gz
dist/
build/

# Dependencies (the site itself has none; this covers local tooling)
node_modules/
package-lock.json
yarn.lock

# Editor and OS noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# Logs and local scratch
*.log
.cache/
.tmp/

# Generated single-file prototype
studyflow-prototype.html
proto/

# Written by scripts/write-config.js during the Netlify build. app/config.js is
# committed as a blank stub on purpose (so the app runs with no backend) and is
# overwritten at deploy time; version.json and _headers only exist once deployed.
version.json
_headers
